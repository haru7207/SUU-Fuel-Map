{
  "rewrites": [
    {
      "source": "/api/awc/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/gemini/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/dinner",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
